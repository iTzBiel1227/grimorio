{
  "name": "grimorio-rpg",
  "version": "1.0.0",
  "description": "Grimório — plataforma de RPG com contas, campanhas e mesa em tempo real",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "preview": "node scripts/preview.mjs",
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test tests/*.test.js",
    "test:api": "node tests/api-smoke.mjs",
    "test:content": "node tests/content-api.mjs",
    "test:friends": "node tests/friends-api.mjs",
    "test:e2e": "node scripts/build-dice.mjs && node tests/community-e2e.mjs",
    "test:supabase:remote": "node scripts/check-supabase.mjs",
    "sync": "node scripts/sync-github.mjs",
    "prestart": "node scripts/build-dice.mjs",
    "pretest": "node scripts/build-dice.mjs",
    "prebuild": "node scripts/build-dice.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "better-sqlite3": "^12.2.0",
    "cannon-es": "0.20.0",
    "express": "^5.1.0",
    "socket.io": "^4.8.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@playwright/test": "1.64.1",
    "esbuild": "^0.28.2"
  }
}
