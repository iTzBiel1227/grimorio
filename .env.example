# Optional override of supabase/frontend.json. Both values are public.
SUPABASE_URL=https://fisrzivzjfehmdnoxfkx.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Use the publishable key from Supabase Project Settings > API Keys.
# Never use a service_role, secret key, database password or access token here.
# For a local Supabase preview: node --env-file=.env scripts/build.mjs
# Without overrides, npm run build uses the public project configuration.
# npm start continues to use the original local SQLite app.
# For a static legacy build, set GRIMORIO_BACKEND=sqlite.
